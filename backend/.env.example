NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fpiupdates:local_only@127.0.0.1:55432/fpiupdates
DB_POOL_MAX=3
FRONTEND_ORIGINS=http://localhost:5173

APP_URL=http://localhost:5173
EMAIL_TRANSPORT=file
REQUIRE_VERIFIED_EMAIL=false
# Production: use EMAIL_TRANSPORT=smtp or gmail-api with real credentials.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=
# SMTP_FROM=FpiUpdates <you@example.com>

# Persistent image storage; keep outside the publicly served frontend directory.
# Default is backend/.uploads. Back up this directory together with PostgreSQL.
# MEDIA_DIRECTORY=/absolute/path/to/fpiupdates-media

# Automatic article scheduling runs inside the API every 15 seconds.
# Tests/maintenance only: PUBLISHING_WORKER_DISABLED=true

# Analytics housekeeping/report worker runs in the API every minute.
# Isolated tests/maintenance only: ANALYTICS_WORKER_DISABLED=true

# Google sign-in: configure all three values to show the button.
# Create a Google OAuth "Web application" client; secrets stay on the backend.
# See docs/GOOGLE-SIGN-IN.md. Do not use VITE_ variables for secrets.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Gmail SMTP for local testing: smtp.gmail.com, port 465, Gmail app password.
# Gmail API is an HTTPS alternative when hosts block SMTP (e.g. Render Free).
# EMAIL_TRANSPORT=gmail-api
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# SMTP_FROM=FpiUpdates <your-sender@gmail.com>
# See docs/GMAIL-AND-STAGING.md. OAuth mail consent is separate from Google login.

# Optional single-origin hosting of the built frontend (Docker enables it).
# SERVE_FRONTEND=true
# FRONTEND_DIRECTORY=../frontend/dist
# Ephemeral staging: pause ALL new uploads, including avatar/cover images.
# MEDIA_UPLOADS_DISABLED=true

# Only when your server is behind the corresponding trusted reverse proxy.
# TRUST_PROXY_HOPS=1

# Persistent media. Existing media records retain their original provider.
MEDIA_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Keep true on ephemeral hosting until R2 has passed npm run storage:test.
# MEDIA_UPLOADS_DISABLED=true

# Background push needs a continuous API process and outbound HTTPS.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
