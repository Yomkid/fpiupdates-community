{
  "name": "@fpiupdates/backend",
  "version": "0.28.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test .test-dist/test/integration/*.test.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:validate": "prisma validate",
    "admin:grant": "node scripts/grant-admin.cjs",
    "gmail:authorize": "node scripts/gmail-authorize.cjs",
    "email:test": "node scripts/test-email.cjs",
    "storage:test": "npm run build && node dist/storage-check.js",
    "storage:migrate": "npm run build && node dist/storage-migrate.js",
    "push:configure": "node scripts/configure-push.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "linkifyjs": "^4.3.3",
    "nodemailer": "^10.1.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.0.0",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0"
  }
}
